---
import BaseHead from '../components/BaseHead.astro';
import Nav from '../components/Nav.astro';
import Ambient from '../components/Ambient.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  article?: boolean;
}
const { title, description, ogImage, article } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} ogImage={ogImage} article={article} />
  </head>
  <body>
    <Ambient />
    <Nav />
    <slot />
    <Footer />
  </body>
</html>
