---
import BaseLayout from './BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import type { MarkdownHeading } from 'astro';

interface Props {
  post: CollectionEntry<'posts'>;
  headings: MarkdownHeading[];
}
const { post, headings } = Astro.props;
const { title, description, date, tag, readingTime, cover, series } = post.data;

const dateStr = date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
const toc = headings.filter((h) => h.depth === 2);

// Prev/next come from the series' running order, not from a hand-maintained
// link in the body — adding part 5 no longer means editing part 4.
const all = series ? await getCollection('posts', ({ data }) => !data.draft) : [];
const atPart = (part: number) =>
  all.find((p) => p.data.series?.name === series!.name && p.data.series.part === part);
const prev = series ? atPart(series.part - 1) : undefined;
const next = series ? atPart(series.part + 1) : undefined;
---
<BaseLayout
  title={`${title} — Vladimir Traigel`}
  description={description}
  ogImage={`/og/${post.id}.png`}
  article={true}
>
  <div class="prog"></div>
  <main class="article">
    <div class="wrap">
      {series && (
        <div class="series" data-tag={tag}>
          <div class="pips">
            {Array.from({ length: series.of }, (_, i) => (
              <>
                {i > 0 && <b></b>}
                <i class={i < series.part ? 'on' : undefined}></i>
              </>
            ))}
          </div>
          <span class="slab">Part {series.part} of {series.of}</span>
          <span class="snm">{series.name}</span>
        </div>
      )}

      <div class="ahead" data-tag={tag}>
        <div>
          <div class="ameta">
            <span class="tg"><i></i>{tag}</span>
            <span class="sep">/</span>
            <span>{dateStr}</span>
            {readingTime && (
              <>
                <span class="sep">/</span>
                <span>{readingTime}</span>
              </>
            )}
          </div>
          <h1>{title}</h1>
          <p class="stand">{description}</p>
        </div>
        <div class="cover">
          {cover.image ? (
            <Image
              src={cover.image}
              alt={cover.alt ?? ''}
              widths={[480, 720, 1000]}
              sizes="(max-width:900px) 100vw, 470px"
              loading="eager"
              fetchpriority="high"
            />
          ) : (
            <div class="grad" style={`--g1:${cover.from};--g2:${cover.to}`}><span>{tag}</span></div>
          )}
        </div>
      </div>

      <div class="abody">
        <div class="prose">
          <slot />
        </div>
        {toc.length > 1 && (
          <aside class="toc" data-tag={tag}>
            <div class="rhd">On this page</div>
            <ol>
              {toc.map((h) => (
                <li><a href={`#${h.slug}`}>{h.text}</a></li>
              ))}
            </ol>
          </aside>
        )}
      </div>

      <div class="afoot">
        {(prev || next) && <div class="fhd">{series!.name}</div>}
        <div class="pair">
          {prev && (
            <a class="np" href={`/writing/${prev.id}/`} data-tag={prev.data.tag}>
              <div class="th">
                {prev.data.cover.image ? (
                  <Image src={prev.data.cover.image} alt="" widths={[96, 192]} sizes="96px" />
                ) : (
                  <div class="grad" style={`--g1:${prev.data.cover.from};--g2:${prev.data.cover.to}`}></div>
                )}
              </div>
              <div>
                <div class="dir">← Part {prev.data.series!.part}</div>
                <div class="t">{prev.data.title}</div>
              </div>
            </a>
          )}
          {next && (
            <a class="np rt" href={`/writing/${next.id}/`} data-tag={next.data.tag}>
              <div>
                <div class="dir">Part {next.data.series!.part} →</div>
                <div class="t">{next.data.title}</div>
              </div>
              <div class="th">
                {next.data.cover.image ? (
                  <Image src={next.data.cover.image} alt="" widths={[96, 192]} sizes="96px" />
                ) : (
                  <div class="grad" style={`--g1:${next.data.cover.from};--g2:${next.data.cover.to}`}></div>
                )}
              </div>
            </a>
          )}
        </div>
        <a class="back" href="/writing/">← All writing</a>
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  // One scroll handler drives both the progress rule and the active TOC
  // section — cheaper and less fiddly than an IntersectionObserver, and it
  // stays correct after resizes and image loads.
  const bar = document.querySelector<HTMLElement>('.prog');
  const article = document.querySelector<HTMLElement>('.article');
  const items = new Map<HTMLElement, HTMLElement>();
  document.querySelectorAll<HTMLAnchorElement>('.toc a').forEach((a) => {
    const target = document.getElementById(decodeURIComponent(a.hash.slice(1)));
    if (target && a.parentElement) items.set(target, a.parentElement);
  });

  if (bar && article) {
    const update = () => {
      const start = article.offsetTop;
      const span = article.offsetHeight - window.innerHeight;
      const ratio = span <= 0 ? 1 : (window.scrollY - start) / span;
      bar.style.width = `${Math.min(100, Math.max(0, ratio * 100))}%`;

      let active: HTMLElement | undefined;
      for (const heading of items.keys()) {
        if (heading.getBoundingClientRect().top <= 96) active = heading;
      }
      items.forEach((li, heading) => li.classList.toggle('on', heading === active));
    };
    update();
    addEventListener('scroll', update, { passive: true });
    addEventListener('resize', update);
  }
</script>
