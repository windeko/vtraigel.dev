---
const caps = [
  {
    title: 'AI & LLM systems',
    body: 'Production multi-agent systems with LangGraph and the Vercel AI SDK, wired across Anthropic, Bedrock, Groq, OpenAI and Gemini.',
  },
  {
    title: 'Full-stack engineering',
    body: 'End-to-end TypeScript — Node.js services and React front ends, built to be owned by one engineer from API to UI.',
  },
  {
    title: 'Cloud infrastructure',
    body: 'Pulumi and AWS, splitting monoliths into event-driven microservices without stopping feature work.',
  },
];
---
<section id="work">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="eyebrow">What I do</span>
      <h2>Where I spend my engineering time</h2>
    </div>
    <div class="caps reveal">
      {caps.map((c) => (
        <div class="cap card">
          <h3>{c.title}</h3>
          <p>{c.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>
