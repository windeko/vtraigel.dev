---
import { SITE, SOCIALS } from '../consts';
---
<section class="contact" id="contact">
  <div class="wrap">
    <span class="eyebrow">Contact</span>
    <h2>Let's build something good.</h2>
    <p>Open to interesting problems, collaborations, and conversations about AI engineering.</p>
    <div class="links">
      <a href={`mailto:${SITE.email}`}>✉ Email</a>
      <a href={SOCIALS.linkedin} target="_blank" rel="me noopener">in LinkedIn</a>
      <a href={SOCIALS.github} target="_blank" rel="me noopener">⌥ GitHub</a>
      <a href={SOCIALS.telegram} target="_blank" rel="me noopener">✈ Telegram</a>
      <a href="/cv/Vladimir-Traigel-CV.pdf" target="_blank" rel="noopener">↓ CV</a>
    </div>
  </div>
</section>
