---
import { SITE, SOCIALS } from '../consts';
---
<section class="contact" id="contact">
  <div class="wrap">
    <span class="eyebrow reveal">Contact</span>
    <h2 class="reveal">Let's build something good.</h2>
    <p class="reveal">Open to interesting problems, collaborations, and conversations about AI engineering.</p>
    <div class="links reveal">
      <a href={`mailto:${SITE.email}`}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
        Email
      </a>
      <a href={SOCIALS.linkedin} target="_blank" rel="me noopener">
        <span class="li">in</span>
        LinkedIn
      </a>
      <a href={SOCIALS.github} target="_blank" rel="me noopener">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5L3 12l5 7M16 5l5 7-5 7"/></svg>
        GitHub
      </a>
      <a href={SOCIALS.telegram} target="_blank" rel="me noopener">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 2L11 13"/><path d="M22 2l-7 20-4-9-9-4z"/></svg>
        Telegram
      </a>
      <a href="/cv/Vladimir-Traigel-CV.pdf" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12M7 10l5 5 5-5"/><path d="M4 19h16"/></svg>
        CV
      </a>
    </div>
  </div>
</section>
