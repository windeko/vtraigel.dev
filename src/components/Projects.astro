---
import { PROJECTS } from '../data/projects';
---
<section id="projects">
  <div class="wrap">
    <div class="sec-head">
      <span class="eyebrow">Projects</span>
      <h2>Things I build to learn.</h2>
      <p>Side projects where I get to experiment end-to-end, from idea to production.</p>
    </div>
    <div class="projects">
      {PROJECTS.map((p) => (
        <div class="proj card">
          <div class="proj-top">
            <h3>{p.name}</h3>
            <span class={`status${p.live ? ' live' : ''}`}>{p.status}</span>
          </div>
          <p>{p.description}</p>
          <div class="stack">
            {p.stack.map((s) => <span>{s}</span>)}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
